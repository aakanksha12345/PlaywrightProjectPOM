{
  "name": "playwright-parabank-pom",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript Page Object Model starter for ParaBank",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:all": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.15.30",
    "dotenv": "^17.2.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
